# Copy this file to .env and fill in your own key. .env is gitignored - never commit a real key.

# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides - defaults are baked into groq-classifier.client.ts
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Required. Signs login session tokens - generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=
